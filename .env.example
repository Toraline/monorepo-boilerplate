# Copy this file to .env and fill the values. Never commit .env.
# "make setup" makes the copy for you when .env does not exist.
# Every value here is an invented sample. No real key belongs in this file.

# Linear and GitHub are reached through their MCP servers and the gh CLI,
# which sign in through the browser. They need no key in this file.

# --- PostgreSQL in Docker (docker-compose.yml) ---
# The database runs only on this machine. These sample values work as they are.
POSTGRES_USER=todo
POSTGRES_PASSWORD=sample-password-for-local-use
POSTGRES_DB=todo
# The address that the apps use to reach the database.
# 127.0.0.1 and not localhost: localhost can resolve to another address (::1)
# and reach a different PostgreSQL server on the same port.
POSTGRES_HOST=127.0.0.1
# The port on this machine. The main checkout uses 5432. In a worktree,
# scripts/worktree-setup.local.sh replaces this value with the first free
# port from 5433 up, so two checkouts never use the same port.
POSTGRES_PORT=5432

# --- The server (apps/api, Django) ---
# The key that Django signs cookies with. This value is an invented sample.
# The server refuses it when DJANGO_DEBUG is not True.
DJANGO_SECRET_KEY=sample-django-secret-key-for-local-use-only-replace-it-on-a-real-server
# True means local mode: the server runs on your own machine. Detailed error
# pages are on and cookies work over http. On a real server: remove this line
# or set it to False.
DJANGO_DEBUG=True
# The host names that the server answers to, separated by commas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The addresses of the web apps whose pages may call the server from a browser,
# separated by commas: apps/web (port 3000) and apps/internal (port 3001).
# Write them with "localhost", and open the web apps with "localhost" too.
WEB_ORIGINS=http://localhost:3000,http://localhost:3001
# The cookies of the login. apps/api/README.md explains these three values.
# Without these lines: Secure is off in local mode and on otherwise, SameSite
# is Lax, and a login lasts 14 days (1209600 seconds).
# COOKIE_SECURE=False
# COOKIE_SAMESITE=Lax
# SESSION_COOKIE_AGE=1209600
# The first admin, created by "make seed". Invented sample values.
# With them you log in to http://localhost:8000/admin/ on your own machine.
# "make seed" refuses this sample password when DJANGO_DEBUG is not True.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=sample-admin-password-for-local-use
SEED_ADMIN_NAME=Sample Admin
# The password of the 2 sample users that "make seed-sample" creates:
# ana.lima@example.com and bruno.reis@example.com. Invented sample value.
# "make seed-sample" is optional, and it runs only when DJANGO_DEBUG is True.
SEED_SAMPLE_PASSWORD=sample-user-password-for-local-use

# --- The web apps (apps/web and apps/internal, Next.js) ---
# The address of the server that the pages of the web apps call from the
# browser. Write it with "localhost", as in WEB_ORIGINS above.
# The name starts with NEXT_PUBLIC_ because Next.js gives the code in the
# browser only the variables with that start. Never put a secret in such a
# variable: every visitor can read its value.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Add the keys of your apps below, names only:
# EXAMPLE_API_KEY=
